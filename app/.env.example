# Copy to app/.env and replace placeholders before starting the app.

# Shelly Cloud credentials.
SHELLY_AUTH_KEY=replace-me

# Set to 1/true to use simulated Shelly responses during local development.
SHELLY_SIMULATE_DEVICES=0

# Prefer LAN targets where configured; cloud remains the fallback.
USE_LAN_DEVICES=1
USE_LAN_WATTAGE=1
SHELLY_MAX_API_CALLS=3

# Persistent runtime files. Docker production uses the /data volume.
DEVICE_STATE_PATH=/data/device-states.json
SCENE_OVERRIDE_PATH=/data/scene-overrides.json

# Host maintenance API.
KENNEMER_MAINTENANCE_URL=http://host.docker.internal:8787
KENNEMER_MAINTENANCE_TOKEN=replace-me-with-a-long-random-token

# Required server-side PIN for saving scene-ID changes in Advanced Controls.
KENNEMER_CONFIG_EDIT_PIN=replace-me-with-a-separate-config-pin

# Advanced controls unlock pattern.
PUBLIC_ADVANCED_PATTERN=1234
PUBLIC_ADVANCED_PIN=
PUBLIC_ADVANCED_PROMPT_IDLE_MS=30000
PUBLIC_ADVANCED_PANEL_IDLE_MS=300000

# Dashboard behavior.
PUBLIC_DISABLE_WATTAGE=0
PUBLIC_DEBUG_WATTAGE=0
PUBLIC_DISPLAY_DIM_TIMEOUT_MS=600000

# Optional Shelly/connectivity overrides.
# PUBLIC_SHELLY_SCENE_ENDPOINT=https://shelly-115-eu.shelly.cloud/scene/manual_run
# CONNECTIVITY_CHECK_URL=https://shelly-115-eu.shelly.cloud/

# Optional HTTPS server settings for app/server.js.
# HTTPS_PORT=443
# HTTPS_KEY_PATH=/certs/server.key
# HTTPS_CERT_PATH=/certs/server.crt
# HTTPS_CA_PATH=/certs/ca.pem
# HTTPS_PASSPHRASE=replace-me
