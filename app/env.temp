###############################################
# How to use this template:
# 1. Copy this file to app/.env (or run `cp app/env.temp app/.env`).
# 2. Replace every placeholder value with your real credentials.
# 3. Restart the app so the new env values are picked up.
###############################################

# Required Shelly API key that has read/write permissions.
# Generate it in the Shelly Cloud dashboard and paste it below.
SHELLY_AUTH_KEY=replace-me

# Set to "true" (or 1/yes) to enable simulated devices and skip real Shelly requests.
SHELLY_SIMULATE_DEVICES=1
USE_LAN=0

# Maximum number of retry attempts when calling the Shelly API after a rate limit (0 disables retries).
SHELLY_MAX_API_CALLS=3

# Cache Shelly status responses (in milliseconds) to reduce external API calls.
# Example: 10000 caches for 10 seconds. Set to 0 to disable caching.
SHELLY_STATUS_CACHE_TTL_MS=5000

# Numeric PIN users must enter to access advanced controls in the public UI.
PUBLIC_ADVANCED_PIN=1234
