###############################################
# How to use this template:
# 1. Copy this file to app/.env (or run `cp app/env.temp app/.env`).
# 2. Replace every placeholder value with your real credentials.
# 3. Restart the app so the new env values are picked up.
###############################################

# Required Shelly API key that has read/write permissions.
# Generate it in the Shelly Cloud dashboard and paste it below.
SHELLY_AUTH_KEY=replace-me

# Set to "true" (or 1/yes) to enable simulated devices and skip real Shelly requests.
SHELLY_SIMULATE_DEVICES=1

# Prefer LAN endpoints over cloud (falls back automatically if a command only defines cloud targets).
# You can also set USE_LOCAL with the same values if you prefer that name.
USE_LAN=0
# USE_LOCAL=0

# Maximum number of retry attempts when calling the Shelly API after a rate limit (0 disables retries).
SHELLY_MAX_API_CALLS=3

# Pattern users must draw to access advanced controls in the public UI (digits 0-9, row-major).
# Example: 125890 translates to top-left -> top-middle -> center -> bottom-middle -> bottom-center (0).
PUBLIC_ADVANCED_PATTERN=125890

# Set to "true" (or 1/yes) to hide the detailed wattage list and show a compact summary bar.
PUBLIC_COMPACT_WATTAGE=0

# Set to "true" (or 1/yes) to disable wattage fetching entirely and hide the summary.
PUBLIC_DISABLE_WATTAGE=0
