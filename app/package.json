{
	"name": "kennemer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs mock",
		"build": "svelte-kit sync && npm run validate:config && vite build",
		"start": "node server.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"dev:live": "node scripts/dev.mjs live",
		"validate:config": "node scripts/validate-config.mjs",
		"test": "node --experimental-strip-types --test tests/*.test.mjs",
		"test:ui": "node scripts/test-ui.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^5.2.5",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/typography": "^0.5.18",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^24.10.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"vite": "^7.1.7"
	},
	"dependencies": {
		"lucide-svelte": "^0.553.0",
		"write-file-atomic": "^7.0.1",
		"zod": "^4.6.5"
	}
}
