#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/kennemer

recover() {
	local container_id status health

	container_id="$(docker compose ps -q web 2>/dev/null || true)"
	status=""
	health=""
	if [[ -n "$container_id" ]]; then
		status="$(docker inspect --format '{{.State.Status}}' "$container_id" 2>/dev/null || true)"
		health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container_id" 2>/dev/null || true)"
	fi

	if [[ "$status" == "running" && "$health" == "unhealthy" ]]; then
		echo "Restarting unhealthy Kennemer container"
		docker compose restart web
	else
		echo "Ensuring Kennemer container is running"
		docker compose up -d --remove-orphans
	fi

	/usr/local/sbin/kennemer-wait-ready
}

recover
systemd-notify --ready --status="Kennemer application is healthy"

failures=0
while true; do
	sleep 5

	container_id="$(docker compose ps -q web 2>/dev/null || true)"
	status=""
	health=""
	if [[ -n "$container_id" ]]; then
		status="$(docker inspect --format '{{.State.Status}}' "$container_id" 2>/dev/null || true)"
		health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container_id" 2>/dev/null || true)"
	fi

	if [[ "$status" == "running" && "$health" == "healthy" ]] &&
		curl --fail --silent --max-time 5 http://127.0.0.1/ >/dev/null; then
		failures=0
		continue
	fi

	failures=$((failures + 1))
	systemd-notify --status="Application health check failed ($failures/3)"
	if ((failures < 3)); then
		continue
	fi

	recover
	failures=0
	systemd-notify --status="Kennemer application recovered"
done
