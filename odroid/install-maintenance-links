#!/usr/bin/env bash
set -Eeuo pipefail

REPO="${KENNEMER_REPO:-/opt/kennemer}"

if [[ ! -d "$REPO/.git" ]]; then
	echo "Kennemer repository not found at $REPO" >&2
	exit 1
fi

install -d -o root -g root /usr/local/bin /usr/local/sbin /usr/local/libexec
install -d -o root -g root /etc/systemd/system

ln -sfn "$REPO/odroid/screen" /usr/local/sbin/kennemer-kiosk
ln -sfn "$REPO/odroid/screen" /usr/local/bin/screen
ln -sfn "$REPO/odroid/restart" /usr/local/bin/restart
ln -sfn "$REPO/odroid/update" /usr/local/bin/update
ln -sfn "$REPO/odroid/update" /usr/local/sbin/kennemer-update
ln -sfn "$REPO/odroid/kiosk-session" /usr/local/libexec/kennemer-kiosk-session
ln -sfn "$REPO/odroid/kennemer-maintenance-api.service" /etc/systemd/system/kennemer-maintenance-api.service

systemctl daemon-reload
systemctl enable kennemer-maintenance-api.service
systemctl restart kennemer-maintenance-api.service

echo "Installed repository-backed kiosk maintenance commands:"
readlink -f \
	/usr/local/sbin/kennemer-kiosk \
	/usr/local/bin/screen \
	/usr/local/bin/restart \
	/usr/local/bin/update \
	/usr/local/sbin/kennemer-update \
	/usr/local/libexec/kennemer-kiosk-session \
	/etc/systemd/system/kennemer-maintenance-api.service
