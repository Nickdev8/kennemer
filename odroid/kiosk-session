#!/usr/bin/env bash
set -Eeuo pipefail

BROWSER="/opt/brave.com/brave/brave"
URL="${KIOSK_URL:-http://127.0.0.1/}"
PROFILE_DIR="${KIOSK_PROFILE_DIR:-$HOME/.config/kennemer-kiosk}"

WM_PID=""
BROWSER_PID=""

terminate_process() {
	local pid="${1:-}"
	local name="${2:-process}"

	[[ -n "$pid" ]] || return 0
	kill -0 "$pid" 2>/dev/null || return 0

	kill -TERM "$pid" 2>/dev/null || true
	for _ in $(seq 1 48); do
		kill -0 "$pid" 2>/dev/null || return 0
		sleep 0.25
	done

	echo "$name did not stop cleanly; sending SIGKILL" >&2
	kill -KILL "$pid" 2>/dev/null || true
}

cleanup() {
	trap - EXIT INT TERM
	terminate_process "$BROWSER_PID" "Brave"
	terminate_process "$WM_PID" "Openbox"
	wait "$BROWSER_PID" "$WM_PID" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

mkdir -p "$PROFILE_DIR/Default"

# Brave's own sidebar is separate from Chromium's side panel. Enforce "Never"
# before every launch so a browser update or interrupted shutdown cannot restore it.
PROFILE_DIR="$PROFILE_DIR" python3 <<'PY'
import json
import os
from pathlib import Path

preferences = Path(os.environ["PROFILE_DIR"]) / "Default" / "Preferences"
try:
    data = json.loads(preferences.read_text()) if preferences.exists() else {}
except (json.JSONDecodeError, OSError):
    data = {}

if not isinstance(data, dict):
    data = {}

data.setdefault("brave", {}).setdefault("sidebar", {})["sidebar_show_option"] = 3
temporary = preferences.with_suffix(".tmp")
temporary.write_text(json.dumps(data, separators=(",", ":")))
temporary.replace(preferences)
PY

openbox --sm-disable &
WM_PID=$!
sleep 1
kill -0 "$WM_PID"

"$BROWSER" \
	--kiosk \
	--new-window \
	--no-first-run \
	--no-default-browser-check \
	--disable-session-crashed-bubble \
	--disable-extensions \
	--disable-background-networking \
	--disable-component-update \
	--disable-sync \
	--noerrdialogs \
	--password-store=basic \
	--user-data-dir="$PROFILE_DIR" \
	--disable-gpu \
	--use-gl=swiftshader \
	--ozone-platform=x11 \
	--in-process-gpu \
	--disable-features=BraveSidebar,Sidebar,SidePanel,SidePanelPinning,BookmarksBar,BraveWallet \
	"$URL" &
BROWSER_PID=$!

set +e
wait -n "$WM_PID" "$BROWSER_PID"
set -e

echo "Openbox or Brave exited; requesting a clean kiosk restart" >&2
exit 1
