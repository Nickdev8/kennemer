[Unit]
Description=Kennemer HDMI kiosk
Requires=kennemer-app.service
After=kennemer-app.service systemd-user-sessions.service
Conflicts=getty@tty7.service
ConditionPathExists=/dev/fb0
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
Environment=KIOSK_USER=kiosk
Environment=DISPLAY=:0
ExecStart=/usr/local/sbin/kennemer-kiosk start
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStartSec=90
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
