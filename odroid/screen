#!/usr/bin/env bash
set -Eeuo pipefail

KIOSK_USER="${KIOSK_USER:-kiosk}"
DISPLAY_NUM="${DISPLAY:-:0}"
VT="${KIOSK_VT:-vt7}"
VT_NUM="${VT#vt}"
APP_URL="${KIOSK_URL:-http://127.0.0.1/}"
XORG_BIN="${XORG_BIN:-/usr/lib/xorg/Xorg}"
SESSION_BIN="${SESSION_BIN:-/usr/local/libexec/kennemer-kiosk-session}"

XORG_PID=""
SESSION_PID=""

log() {
	printf '[%s] %s\n' "$(date --iso-8601=seconds)" "$*"
}

terminate_pid() {
	local pid="${1:-}"
	local name="${2:-process}"

	[[ -n "$pid" ]] || return 0
	kill -0 "$pid" 2>/dev/null || return 0

	log "Stopping $name (pid $pid)"
	kill -TERM "$pid" 2>/dev/null || true
	for _ in $(seq 1 20); do
		kill -0 "$pid" 2>/dev/null || return 0
		sleep 0.25
	done

	log "$name did not stop cleanly; sending SIGKILL"
	kill -KILL "$pid" 2>/dev/null || true
}

cleanup() {
	trap - EXIT INT TERM
	terminate_pid "$SESSION_PID" "kiosk session"
	terminate_pid "$XORG_PID" "Xorg"
	wait "$SESSION_PID" "$XORG_PID" 2>/dev/null || true
}

cleanup_stale_session() {
	local pids

	pids="$(pgrep -u "$KIOSK_USER" -f '/opt/brave.com/brave/brave|openbox --sm-disable' || true)"
	if [[ -n "$pids" ]]; then
		log "Removing stale kiosk user processes: $pids"
		kill -TERM $pids 2>/dev/null || true
		sleep 2
		kill -KILL $pids 2>/dev/null || true
	fi

	pids="$(pgrep -f "Xorg ${DISPLAY_NUM}( |$)" || true)"
	if [[ -n "$pids" ]]; then
		log "Removing stale Xorg processes: $pids"
		kill -TERM $pids 2>/dev/null || true
		sleep 2
		kill -KILL $pids 2>/dev/null || true
	fi

	if ! pgrep -f "Xorg ${DISPLAY_NUM}( |$)" >/dev/null; then
		rm -f "/tmp/.X${DISPLAY_NUM#:}-lock" "/tmp/.X11-unix/X${DISPLAY_NUM#:}"
	fi
}

wait_for_x() {
	for _ in $(seq 1 120); do
		if kill -0 "$XORG_PID" 2>/dev/null &&
			xdpyinfo -display "$DISPLAY_NUM" >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.5
	done

	return 1
}

keep_display_awake() {
	DISPLAY="$DISPLAY_NUM" xset s off s noblank dpms force on -dpms >/dev/null 2>&1 || true
}

start_xorg() {
	log "Starting Xorg on $DISPLAY_NUM using $VT"
	"$XORG_BIN" "$DISPLAY_NUM" "$VT" -nolisten tcp \
		-configdir /etc/X11/xorg.conf.d &
	XORG_PID=$!

	chvt "$VT_NUM" 2>/dev/null || true
	if ! wait_for_x; then
		log "Xorg did not become ready"
		return 1
	fi

	keep_display_awake
	DISPLAY="$DISPLAY_NUM" xhost "+SI:localuser:$KIOSK_USER" >/dev/null
	for _ in $(seq 1 40); do
		if runuser -u "$KIOSK_USER" -- env DISPLAY="$DISPLAY_NUM" \
			xdpyinfo >/dev/null 2>&1; then
			log "Xorg is ready"
			return 0
		fi
		sleep 0.25
	done

	log "Xorg is not accessible to $KIOSK_USER"
	return 1
}

start_session() {
	log "Starting Openbox and Brave"
	runuser -u "$KIOSK_USER" -- env \
		DISPLAY="$DISPLAY_NUM" \
		KIOSK_URL="$APP_URL" \
		HOME="/home/$KIOSK_USER" \
		dbus-run-session -- "$SESSION_BIN" &
	SESSION_PID=$!
}

watch_session() {
	local failures=0

	while kill -0 "$XORG_PID" 2>/dev/null &&
		kill -0 "$SESSION_PID" 2>/dev/null; do
		if xdpyinfo -display "$DISPLAY_NUM" >/dev/null 2>&1 &&
			curl --fail --silent --show-error --max-time 5 "$APP_URL" >/dev/null; then
			keep_display_awake
			failures=0
		else
			failures=$((failures + 1))
			log "Health check failed ($failures/3)"
			if ((failures >= 3)); then
				return 1
			fi
		fi
		sleep 5
	done

	log "A supervised kiosk process exited"
	return 1
}

command_start() {
	trap cleanup EXIT INT TERM

	cleanup_stale_session
	start_xorg
	start_session
	log "Kiosk is online"
	watch_session
}

command_stop() {
	cleanup_stale_session
}

case "${1:-}" in
	start)
		command_start
		;;
	stop)
		command_stop
		;;
	status)
		xdpyinfo -display "$DISPLAY_NUM" >/dev/null 2>&1 &&
			pgrep -u "$KIOSK_USER" -f '/opt/brave.com/brave/brave.*--kiosk' >/dev/null &&
			curl --fail --silent --max-time 5 "$APP_URL" >/dev/null
		;;
	*)
		echo "Usage: $0 {start|stop|status}" >&2
		exit 2
		;;
esac
